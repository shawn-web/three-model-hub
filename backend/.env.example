# 运行环境
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=three_model_hub
DB_LOGGING=false

# MinIO 配置
# 桶名（bucket）建议改成与项目名一致，如 three-model-hub；
# 留空则使用默认值 three-mode（向后兼容）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=three-model-hub
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_DATA_DIR=./.minio-data

# 上传限制
MAX_UPLOAD_SIZE_MB=1024
UPLOAD_CLEANUP_THRESHOLD_HOURS=24

# CORS（生产环境设置允许的域名，多个用逗号分隔；开发环境留空允许所有）
CORS_ORIGINS=

# 服务端口
PORT=3000
