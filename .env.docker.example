# three-model-hub Docker 部署环境变量
#
# 使用方式：
#   cp .env.docker.example .env
#   然后按下方提示修改口令，再执行 docker compose -f docker-compose.prod.yml up -d
#
# 生成随机口令（Linux/macOS）：
#   openssl rand -base64 24
# Windows PowerShell：
#   [Convert]::ToBase64String((1..24|%{Get-Random -Max 256})) -replace '[+/=]','x'

# ── 镜像来源 ────────────────────────────────────────────────────
# 只填「域名/命名空间」这一段，镜像名（three-model-hub-backend 等）由编排文件拼接。
#
#   ghcr.io/shawn-web                                       GitHub Container Registry
#   registry.cn-hangzhou.aliyuncs.com/lishuaistart           阿里云 ACR（杭州）
#   ccr.ccs.tencentyun.com/yournamespace                    腾讯云 TCR
#   swr.cn-north-4.myhuaweicloud.com/yournamespace          华为云 SWR
#   docker.io/yourname                                      Docker Hub
#
# 镜像来自私有仓库时，部署机拉取前要先 docker login。
IMAGE_NAMESPACE=ghcr.io/shawn-web
# 版本标签：latest / 0.1.0 / sha-xxxxxxx
IMAGE_TAG=latest

# ── 对外端口 ────────────────────────────────────────────────────
# 浏览器访问端口，实际入口是 http://<服务器IP>:8080
FRONTEND_PORT=8080
# MinIO 控制台端口（仅绑定 127.0.0.1，需 SSH 隧道访问）
MINIO_CONSOLE_PORT=9001

# ── 数据库 ──────────────────────────────────────────────────────
MYSQL_DATABASE=three_model_hub
# 应用连接用的普通账号（不要填 root）
DB_USERNAME=tmh
# 【必须修改】应用账号口令
DB_PASSWORD=
# 【必须修改】MySQL root 口令（仅运维用，应用不使用）
MYSQL_ROOT_PASSWORD=

# ── MinIO ───────────────────────────────────────────────────────
# 【必须修改】与下面两项不要用默认值 minioadmin
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=three-model-hub

# ── 上传限制 ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=1024
UPLOAD_CLEANUP_THRESHOLD_HOURS=24

# ── iframe 嵌入白名单 ───────────────────────────────────────────
# 两处配置表达同一组允许嵌入的域名，只是语法不同，改的时候要一起改：
#
#   IFRAME_FRAME_ANCESTORS  逗号分隔，供后端 /api/geo-maps/:id/iframe-config 使用
#   FRAME_ANCESTORS         空格分隔且每项带引号，直接写进 CSP 响应头
#
# 只允许同源嵌入（默认）：
IFRAME_FRAME_ANCESTORS=self
FRAME_ANCESTORS='self'
#
# 允许被 https://partner.example.com 嵌入时改成：
# IFRAME_FRAME_ANCESTORS=self,https://partner.example.com
# FRAME_ANCESTORS='self' https://partner.example.com

# ── CORS ────────────────────────────────────────────────────────
# 前后端同源（本编排默认如此）时浏览器不会触发 CORS，可留空。
# 注意：留空表示后端反射任意 Origin 且允许携带凭据，公网部署建议显式填写，
# 例如 https://three-model.example.com
CORS_ORIGINS=

# ── 其他 ────────────────────────────────────────────────────────
# 空库首次启动是否自动建表；确认不需要时可设为 false
DB_AUTO_BOOTSTRAP=true
TZ=Asia/Shanghai
