{
  "name": "three-model-hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const src='node_modules/cesium/Build/Cesium',dst='public/cesium';if(!fs.existsSync(dst)){fs.mkdirSync(dst,{recursive:true});}fs.cpSync(src,dst,{recursive:true,dereference:true});\""
  },
