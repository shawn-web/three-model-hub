    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "cesium": "^1.141.0",
    "react": "^19.3.1",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
